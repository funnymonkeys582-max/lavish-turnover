---
---

<section id="use-cases" class="relative max-w-[1200px] mx-auto px-4 sm:px-6 py-12 md:py-16 border-t border-[#ebebeb]">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[#ebebeb] bg-white text-[12px] font-mono uppercase tracking-wider text-[#8f8f8f] shadow-whisper mb-3">
      Versatile Applications
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-[#171717] tracking-[-0.03em] mb-4">
      Perfect for Every Kind of Blurry Photo
    </h2>
    <p class="text-[15px] text-[#4d4d4d] leading-relaxed">
      Whether it is accidental camera shake, lens defocus, motion blur, or low-resolution compression, our algorithms adapt to the context.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Use Case 1 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
          <svg class="w-5 h-5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#171717] tracking-tight mb-2">
          Portraits & Selfies
        </h3>
        <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
          Brings eyes, eyelashes, and hair texture into sharp focus while delicately preventing skin pores and facial midtones from looking harsh or over-processed.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#ebebeb] text-xs font-mono text-[#0070f3]">
        Preset: 👤 Portrait & Face
      </div>
    </div>

    <!-- Use Case 2 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
          <svg class="w-5 h-5 text-[#7928ca]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#171717] tracking-tight mb-2">
          Invoices, Receipts, & Documents
        </h3>
        <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
          Clarifies unreadable numbers, barcodes, tax codes, and small fine-print letters on shaky smartphone photos of receipts and legal contracts.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#ebebeb] text-xs font-mono text-[#7928ca]">
        Preset: 📄 Document & Text
      </div>
    </div>

    <!-- Use Case 3 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
          <svg class="w-5 h-5 text-[#eb367f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#171717] tracking-tight mb-2">
          Motion & Shaky Camera Shots
        </h3>
        <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
          Recovers soft edges caused by low shutter speeds, moving cars, walking subjects, or hand tremors in low-light environments.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#ebebeb] text-xs font-mono text-[#eb367f]">
        Preset: 📸 Motion Shake
      </div>
    </div>

    <!-- Use Case 4 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
          <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#171717] tracking-tight mb-2">
          Social Media Compression Recovery
        </h3>
        <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
          Overcomes soft pixelation and blur caused by WhatsApp, Messenger, or Instagram compression algorithms before reposting.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#ebebeb] text-xs font-mono text-emerald-600">
        Preset: 🪄 Auto Clarity
      </div>
    </div>

    <!-- Use Case 5 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
          <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#171717] tracking-tight mb-2">
          Vintage & Scanned Photographs
        </h3>
        <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
          Restores historic family archive photos, Polaroid prints, and flatbed scans by tightening blurred contours without destroying analog grain charm.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#ebebeb] text-xs font-mono text-amber-600">
        Preset: 👤 Portrait & Face
      </div>
    </div>

    <!-- Use Case 6 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
          <svg class="w-5 h-5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009 9.35c.66 0 1.282-.213 1.791-.577a3.004 3.004 0 004.418 0c.509.364 1.131.577 1.791.577a2.993 2.993 0 002.459-1.284 3.001 3.001 0 003.75.615V21" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-[#171717] tracking-tight mb-2">
          E-Commerce Product Photos
        </h3>
        <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
          Enhances jewelry, apparel textures, watch faces, and product labels so listings look crisp, professional, and high-converting on Amazon or Shopify.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[#ebebeb] text-xs font-mono text-[#0070f3]">
        Preset: 🪄 Auto Clarity
      </div>
    </div>
  </div>
</section>
