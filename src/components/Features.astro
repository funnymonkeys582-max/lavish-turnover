---
---

<section id="features" class="relative max-w-[1200px] mx-auto px-4 sm:px-6 py-12 md:py-16 border-t border-[#ebebeb]">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[#ebebeb] bg-white text-[12px] font-mono uppercase tracking-wider text-[#8f8f8f] shadow-whisper mb-3">
      Key Advantages
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-[#171717] tracking-[-0.03em] mb-4">
      Engineered for Speed, Clarity, & Privacy
    </h2>
    <p class="text-[15px] text-[#4d4d4d] leading-relaxed">
      Built from scratch with modern web standards to deliver maximum sharpening precision with zero server bottlenecks.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Feature 1 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-5 shadow-whisper hover:border-[#171717]/20 transition-all">
      <div class="w-9 h-9 rounded-[6px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
        <svg class="w-5 h-5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
      </div>
      <h3 class="text-[15px] font-semibold text-[#171717] mb-2 tracking-tight">
        100% Client-Side Privacy
      </h3>
      <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
        Your personal photos, contracts, and medical receipts never leave your browser. Zero bytes are uploaded to remote servers or third parties.
      </p>
    </div>

    <!-- Feature 2 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-5 shadow-whisper hover:border-[#171717]/20 transition-all">
      <div class="w-9 h-9 rounded-[6px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
        <svg class="w-5 h-5 text-[#7928ca]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
      </div>
      <h3 class="text-[15px] font-semibold text-[#171717] mb-2 tracking-tight">
        Instant Millisecond Speed
      </h3>
      <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
        No upload lag, no cloud queuing, and no rendering waiting lists. Adjust sliders and watch results update at 60fps in real time.
      </p>
    </div>

    <!-- Feature 3 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-5 shadow-whisper hover:border-[#171717]/20 transition-all">
      <div class="w-9 h-9 rounded-[6px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
        <svg class="w-5 h-5 text-[#eb367f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
        </svg>
      </div>
      <h3 class="text-[15px] font-semibold text-[#171717] mb-2 tracking-tight">
        Preserves Authentic Detail
      </h3>
      <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
        Unlike generative AI tools that hallucinate fake teeth, distorted fingers, or synthetic textures, our math-based filters sharpen actual authentic pixels.
      </p>
    </div>

    <!-- Feature 4 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-5 shadow-whisper hover:border-[#171717]/20 transition-all">
      <div class="w-9 h-9 rounded-[6px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-4">
        <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-[15px] font-semibold text-[#171717] mb-2 tracking-tight">
        Zero Cost, Zero Watermark
      </h3>
      <p class="text-[13px] text-[#4d4d4d] leading-relaxed">
        Export in full original pixel resolution without paying fees, buying tokens, or having logos stamped on your photography.
      </p>
    </div>
  </div>
</section>
