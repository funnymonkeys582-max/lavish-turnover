---
---

<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] bg-[#fafafa]/85 backdrop-blur-md">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand / Wordmark -->
    <a href="/" class="flex items-center gap-2.5 text-[#171717] font-semibold text-[15px] tracking-tight group">
      <span class="flex items-center gap-1.5 font-medium text-[15px] text-[#171717]">
        RemoveBlur<span class="text-[#0070f3] font-semibold">Online</span>
      </span>
      <span class="hidden md:inline-flex items-center px-2 py-0.5 text-[11px] font-mono uppercase font-medium bg-[#ffffff] border border-[#ebebeb] text-[#171717] rounded-full shadow-whisper">
        100% Free
      </span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-[13px] text-[#4d4d4d]">
      <a href="#unblur-tool" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        Unblur Tool
      </a>
      <a href="#how-it-works" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        How It Works
      </a>
      <a href="#technology" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        Technology
      </a>
      <a href="#guide" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        Guide
      </a>
      <a href="#faq" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        FAQ
      </a>
      <a href="/about-us" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        About Us
      </a>
      <a href="/contact-us" class="px-3 py-1.5 rounded-full hover:text-[#171717] hover:bg-black/[0.04] transition-colors">
        Contact Us
      </a>
    </nav>

    <!-- Right Action CTAs -->
    <div class="flex items-center gap-2.5">
      <div class="hidden sm:flex items-center gap-1.5 text-[12px] font-mono text-[#8f8f8f] px-2.5 py-1 rounded-[6px] border border-[#ebebeb] bg-white">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Uploads • 100% Private
      </div>
      <a
        href="#unblur-tool"
        class="inline-flex items-center justify-center px-3.5 py-1.5 text-[13px] font-medium rounded-full bg-[#171717] text-white hover:bg-black transition-all shadow-whisper active:scale-[0.98]"
      >
        Upload Blurry Photo
      </a>
    </div>
  </div>
</header>
