---
---

<section id="how-it-works" class="relative max-w-[1200px] mx-auto px-4 sm:px-6 py-12 md:py-16 border-t border-[#ebebeb]">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[#ebebeb] bg-white text-[12px] font-mono uppercase tracking-wider text-[#8f8f8f] shadow-whisper mb-3">
      Effortless 3-Step Process
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-[#171717] tracking-[-0.03em] mb-4">
      How to Unblur Images in Seconds
    </h2>
    <p class="text-[15px] text-[#4d4d4d] leading-relaxed">
      No complex Photoshop menus or confusing configurations. Our browser-based engine restores sharpness in three simple steps.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Step 1 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between hover:border-[#171717]/20 transition-all group">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-[#fafafa] border border-[#ebebeb] text-[#171717]">
            STEP 01
          </span>
          <div class="w-8 h-8 rounded-full bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] group-hover:scale-110 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
          </div>
        </div>

        <h3 class="text-lg font-semibold text-[#171717] tracking-tight mb-2">
          Upload Blurry Photo
        </h3>
        <p class="text-[14px] text-[#4d4d4d] leading-relaxed">
          Drag and drop any out-of-focus photo, portrait, or document scan. Paste directly from your clipboard (<kbd class="text-[11px] font-mono bg-[#fafafa] border px-1 py-0.5 rounded">⌘V</kbd>) without saving files first.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#ebebeb] text-xs font-mono text-[#8f8f8f]">
        JPG • PNG • WEBP • HEIC • AVIF
      </div>
    </div>

    <!-- Step 2 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between hover:border-[#171717]/20 transition-all group">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-[#fafafa] border border-[#ebebeb] text-[#0070f3]">
            STEP 02
          </span>
          <div class="w-8 h-8 rounded-full bg-[#0070f3]/10 border border-[#0070f3]/20 flex items-center justify-center text-[#0070f3] group-hover:scale-110 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
        </div>

        <h3 class="text-lg font-semibold text-[#171717] tracking-tight mb-2">
          Automated Edge Sharpening
        </h3>
        <p class="text-[14px] text-[#4d4d4d] leading-relaxed">
          Our client-side mathematical algorithms analyze edge frequencies, deconvolve optical blur, and suppress noise. Choose from Portrait, Document, or Motion presets.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#ebebeb] text-xs font-mono text-[#8f8f8f]">
        Processed in 40ms–180ms locally
      </div>
    </div>

    <!-- Step 3 -->
    <div class="border border-[#ebebeb] bg-white rounded-xl p-6 shadow-whisper flex flex-col justify-between hover:border-[#171717]/20 transition-all group">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-[#fafafa] border border-[#ebebeb] text-emerald-600">
            STEP 03
          </span>
          <div class="w-8 h-8 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 group-hover:scale-110 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
          </div>
        </div>

        <h3 class="text-lg font-semibold text-[#171717] tracking-tight mb-2">
          Compare & Download Full Res
        </h3>
        <p class="text-[14px] text-[#4d4d4d] leading-relaxed">
          Inspect with the split-screen slider or side-by-side mode. Export the restored image at 100% original dimensions with zero watermark in PNG, JPG, or WEBP format.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#ebebeb] text-xs font-mono text-[#8f8f8f]">
        No watermark • 100% Original Quality
      </div>
    </div>
  </div>
</section>
