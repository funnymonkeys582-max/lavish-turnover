---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import UnblurApp from '../components/UnblurApp.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import UseCases from '../components/UseCases.astro';
import TechnologyExplainer from '../components/TechnologyExplainer.astro';
import SeoContent from '../components/SeoContent.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Remove Blur: Remove Blur from Image Online Free | Photo Blur Remover"
  description="Learn how to remove blur from a photo or image online free without watermark. Fast AI remove blur and edge sharpening for portraits, text, and photos with 100% privacy."
>
  <Header />
  <main class="flex-1">
    <Hero />
    <UnblurApp />
    <HowItWorks />
    <Features />
    <UseCases />
    <TechnologyExplainer />
    <SeoContent />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
</Layout>
