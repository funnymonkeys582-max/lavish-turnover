---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us | Remove Blur Online"
  description="Contact Remove Blur Online. Questions about the free photo unblurring tool, privacy, or terms? Reach out to the Remove Blur Online team."
>
  <Header />
  <main class="flex-1 max-w-[1200px] mx-auto px-4 sm:px-6 py-20 md:py-32">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[#ebebeb] bg-white text-[12px] font-mono uppercase tracking-wider text-[#8f8f8f] shadow-whisper mx-auto mb-6">
      Contact Us
    </div>
    <h1 class="text-3xl sm:text-5xl font-semibold text-[#171717] tracking-[-0.04em] mb-6 leading-tight">
      Contact Remove Blur Online
    </h1>
    <p class="text-[15px] sm:text-lg text-[#4d4d4d] max-w-xl mx-auto mb-10 leading-relaxed">
      Have a question about the free photo unblurring tool, privacy, or your results? Get in touch with the Remove Blur Online
      team below.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-2xl mx-auto">
      <section class="space-y-6">
        <h2 class="text-xl sm:text-2xl font-semibold text-[#171717] tracking-[-0.04em] mb-2 leading-tight">
          Send a Message
        </h2>
        <form
          action="https://formspree.io/f/mnqaydzo"
          method="POST"
          class="space-y-4"
        >
          <div>
            <label class="block text-[13px] font-medium text-[#171717] mb-1.5">Name</label>
            <input
              type="text"
              name="name"
              placeholder="Your name"
              class="w-full px-3 py-2 text-[#171717] border border-[#ebebeb] bg-white rounded-sm focus:outline-none focus:ring-1 focus:ring-[#0070f3] transition-all"
              required
            />
          </div>
          <div>
            <label class="block text-[13px] font-medium text-[#171717] mb-1.5">Email</label>
            <input
              type="email"
              name="email"
              placeholder="you@example.com"
              class="w-full px-3 py-2 text-[#171717] border border-[#ebebeb] bg-white rounded-sm focus:outline-none focus:ring-1 focus:ring-[#0070f3] transition-all"
              required
            />
          </div>
          <div>
            <label class="block text-[13px] font-medium text-[#171717] mb-1.5">Subject</label>
            <input
              type="text"
              name="subject"
              placeholder="What is this about?"
              class="w-full px-3 py-2 text-[#171717] border border-[#ebebeb] bg-white rounded-sm focus:outline-none focus:ring-1 focus:ring-[#0070f3] transition-all"
              required
            />
          </div>
          <div>
            <label class="block text-[13px] font-medium text-[#171717] mb-1.5">Message</label>
            <textarea
              name="message"
              rows="5"
              placeholder="Tell us how we can help..."
              class="w-full px-3 py-2 text-[#171717] border border-[#ebebeb] bg-white rounded-sm focus:outline-none focus:ring-1 focus:ring-[#0070f3] transition-all"
              required
            ></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center px-6 py-3 text-[14px] font-medium rounded-full bg-[#171717] text-white shadow-whisper hover:bg-black transition-all active:scale-[0.98]"
          >
            Send Message
          </button>
        </form>
      </section>

      <section class="space-y-6">
        <h2 class="text-xl sm:text-2xl font-semibold text-[#171717] tracking-[-0.04em] mb-2 leading-tight">
          Quick Links
        </h2>
        <ul class="space-y-3 text-[#4d4d4d] leading-relaxed">
          <li>
            <a href="/privacy-policy" class="text-[#0070f3] underline underline-offset-2 hover:text-[#0761d1] transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms-and-conditions" class="text-[#0070f3] underline underline-offset-2 hover:text-[#0761d1] transition-colors">
              Terms and Conditions
            </a>
          </li>
          <li>
            <a href="/about-us" class="text-[#0070f3] underline underline-offset-2 hover:text-[#0761d1] transition-colors">
              About Us
            </a>
          </li>
          <li>
            <a href="/" class="text-[#0070f3] underline underline-offset-2 hover:text-[#0761d1] transition-colors">
              Back to Unblur Tool
            </a>
          </li>
        </ul>

        <div class="mt-6 px-3 py-4 rounded-sm border border-[#ebebeb] bg-white text-[#4d4d4d] leading-relaxed">
          <p class="text-[13px] font-medium text-[#171717] mb-2">
            Privacy note: All image processing happens locally in your browser. We never see, store, or receive your photos.
          </p>
        </div>
      </section>
    </div>

    <div class="mt-16 pt-8 border-t border-[#ebebeb] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#8f8f8f]">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#171717] text-white text-[14px] font-medium shadow-whisper hover:bg-black transition-all active:scale-[0.98]"
      >
        ← Back to Unblur Tool
      </a>
    </div>
  </main>
  <Footer />
</Layout>
