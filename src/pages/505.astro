---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="HTTP Version Not Supported | Remove Blur Online"
  description="The HTTP version used is not supported. Return to Remove Blur Online to unblur your photos online free."
>
  <Header />
  <main class="flex-1 max-w-[1200px] mx-auto px-4 sm:px-6 py-20 md:py-32 text-center">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[#ebebeb] bg-white text-[12px] font-mono uppercase tracking-wider text-[#8f8f8f] shadow-whisper mx-auto mb-6">
      HTTP Version Not Supported
    </div>
    <h1 class="text-3xl sm:text-5xl font-semibold text-[#171717] tracking-[-0.04em] mb-6 leading-tight">
      505 — HTTP Version Not Supported
    </h1>
    <p class="text-[15px] sm:text-lg text-[#4d4d4d] max-w-xl mx-auto mb-10 leading-relaxed">
      The HTTP version used to request this page isn't supported by the server, but your blurry photos can still be restored. Head back to the tool and unblur your image in seconds.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="#"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#171717] text-white text-[14px] font-medium shadow-whisper hover:bg-black transition-all active:scale-[0.98]"
      >
        <svg class="w-4 h-4 text-[#50e3c2]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
        </svg>
        Unblur My Photo Now
      </a>
    </div>
  </main>
  <Footer />
</Layout>
